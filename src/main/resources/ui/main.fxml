<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.MainController"
           style="-fx-font-family: 'Segoe UI', 'Inter', Arial; -fx-font-size: 12;">

    <!-- ═══════════ HOME SCREEN ═══════════ -->
    <ScrollPane fx:id="homeScreen" fitToWidth="true" fitToHeight="true">
        <BorderPane prefWidth="1100" minHeight="720" style="-fx-background-color: #eef2f7;">

        <!-- ================= LEFT PANEL ================= -->
        <left>
            <StackPane prefWidth="520">
                <!-- Background gradient (rendered first = behind) -->
                <StackPane style="-fx-background-color: linear-gradient(to bottom right, #071a67, #0b2b8f, #1b78c9);"/>

                <!-- Content (rendered second = on top) -->
                <VBox alignment="CENTER_LEFT" spacing="18" style="-fx-padding: 48;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="◀▶" style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: 800;"/>
                        <Label text="ScreenAI" style="-fx-font-size: 26; -fx-text-fill: white; -fx-font-weight: 800;"/>
                    </HBox>

                    <Region prefHeight="40"/>

                    <Label text="Access and support&#10;from anywhere"
                           style="-fx-font-size: 46; -fx-text-fill: white; -fx-font-weight: 800; -fx-line-spacing: -4;"/>

                    <Region prefHeight="18"/>

                    <!-- Auth buttons (visible before login) -->
                    <VBox fx:id="authButtonsSection" spacing="18">
                        <Button fx:id="signInButton" text="Sign in to ScreenAI"
                                onAction="#handleSignIn"
                                style="-fx-padding: 10 18;
                                       -fx-background-color: transparent;
                                       -fx-border-color: rgba(255,255,255,0.9);
                                       -fx-border-radius: 10;
                                       -fx-background-radius: 10;
                                       -fx-text-fill: white;
                                       -fx-font-weight: 700;
                                       -fx-cursor: hand;"/>

                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Don't have an account?"
                                   style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13;"/>
                            <Hyperlink fx:id="createAccountLink" text="Create one here"
                                       onAction="#handleCreateAccount"
                                       style="-fx-text-fill: white; -fx-font-size: 13; -fx-underline: true;"/>
                        </HBox>
                    </VBox>

                    <!-- User profile (visible after login) -->
                    <VBox fx:id="userProfileSection" spacing="12" visible="false" managed="false">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <!-- Avatar circle -->
                            <StackPane prefWidth="48" prefHeight="48" minWidth="48" minHeight="48"
                                       style="-fx-background-color: rgba(255,255,255,0.2);
                                              -fx-background-radius: 24;">
                                <Label fx:id="userAvatarLabel" text="U"
                                       style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: 800;"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label fx:id="userDisplayName" text="User"
                                       style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: 800;"/>
                                <Label fx:id="userRoleLabel" text="Authenticated"
                                       style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12;"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT"
                              style="-fx-background-color: rgba(255,255,255,0.1);
                                     -fx-background-radius: 10;
                                     -fx-padding: 10 14;">
                            <Label text="●" style="-fx-text-fill: #39d98a; -fx-font-size: 10;"/>
                            <Label fx:id="sessionStatusLabel" text="Session active"
                                   style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 12;"/>
                        </HBox>

                        <Button fx:id="signOutButton" text="Sign Out"
                                onAction="#handleSignOut"
                                style="-fx-padding: 8 16;
                                       -fx-background-color: rgba(255,255,255,0.1);
                                       -fx-border-color: rgba(255,255,255,0.3);
                                       -fx-border-radius: 10;
                                       -fx-background-radius: 10;
                                       -fx-text-fill: rgba(255,255,255,0.9);
                                       -fx-font-weight: 600;
                                       -fx-font-size: 12;
                                       -fx-cursor: hand;"/>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="securityStatusDot" text="●" style="-fx-text-fill: #39d98a; -fx-font-size: 14;"/>
                        <Label fx:id="securityStatusLabel" text="Ready to connect (secure connection)"
                               style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12;"/>
                    </HBox>
                </VBox>
            </StackPane>
        </left>

        <!-- ================= RIGHT PANEL (TeamViewer Layout) ================= -->
        <center>
            <StackPane style="-fx-padding: 28;">
                <VBox spacing="14" alignment="TOP_RIGHT" prefWidth="520">

                    <!-- Settings gear -->
                    <HBox alignment="CENTER_RIGHT">
                        <Button fx:id="settingsButton" text="⚙"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: #667085;
                                       -fx-font-size: 18;
                                       -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Connection status -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="connectionStatusLabel"
                               text="⏳ Connecting..."
                               style="-fx-font-weight: 800; -fx-text-fill: #1570ef; -fx-font-size: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="hostConnectionStatusLabel"
                               text="🔴 Disconnected"
                               style="-fx-text-fill: #d92d20; -fx-font-weight: 800;"/>
                    </HBox>

                    <!-- ═══ HOST SECTION: Your ID + Password ═══ -->
                    <VBox fx:id="hostSection" spacing="0">

                        <Label text="Share your ID and password with the supporter."
                               style="-fx-text-fill: #475467; -fx-font-size: 13; -fx-padding: 0 0 16 0;"/>

                        <VBox spacing="16"
                              style="-fx-background-color: #f8fafc;
                                     -fx-background-radius: 16;
                                     -fx-border-radius: 16;
                                     -fx-border-color: rgba(16,24,40,0.08);
                                     -fx-padding: 20;">

                            <!-- Your ID -->
                            <VBox spacing="4">
                                <Label text="Your ID"
                                       style="-fx-text-fill: #667085; -fx-font-size: 12; -fx-font-weight: 700;"/>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label fx:id="roomIdInput" text="—"
                                           style="-fx-font-size: 28;
                                                  -fx-font-weight: 900;
                                                  -fx-text-fill: #101828;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="copyRoomIdButton" text="📋"
                                            onAction="#handleCopyId"
                                            style="-fx-background-color: transparent;
                                                   -fx-cursor: hand;
                                                   -fx-padding: 4 8;
                                                   -fx-font-size: 16;"/>
                                </HBox>
                            </VBox>

                            <!-- Password -->
                            <VBox spacing="4">
                                <Label text="Password"
                                       style="-fx-text-fill: #667085; -fx-font-size: 12; -fx-font-weight: 700;"/>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label fx:id="sessionPasswordLabel" text="—"
                                           style="-fx-font-size: 22;
                                                  -fx-font-weight: 900;
                                                  -fx-text-fill: #101828;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="refreshPasswordButton" text="🔄"
                                            onAction="#handleRefreshPassword"
                                            style="-fx-background-color: transparent;
                                                   -fx-cursor: hand;
                                                   -fx-padding: 4 8;
                                                   -fx-font-size: 16;"/>
                                    <Button fx:id="copyPasswordButton" text="📋"
                                            onAction="#handleCopyPassword"
                                            style="-fx-background-color: transparent;
                                                   -fx-cursor: hand;
                                                   -fx-padding: 4 8;
                                                   -fx-font-size: 16;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Host action buttons -->
                        <HBox spacing="10" style="-fx-padding: 14 0 0 0;">
                            <Button fx:id="startButton" text="Start"
                                    onAction="#handleStartHosting"
                                    style="-fx-padding: 10 24;
                                           -fx-background-color: #1570ef;
                                           -fx-background-radius: 10;
                                           -fx-text-fill: white;
                                           -fx-font-weight: 700;
                                           -fx-font-size: 13;
                                           -fx-cursor: hand;"/>
                            <Button fx:id="stopButton" text="Stop"
                                    onAction="#handleStopHosting"
                                    style="-fx-padding: 10 24;
                                           -fx-background-color: transparent;
                                           -fx-border-color: #d0d5dd;
                                           -fx-border-radius: 10;
                                           -fx-background-radius: 10;
                                           -fx-text-fill: #344054;
                                           -fx-font-weight: 700;
                                           -fx-font-size: 13;
                                           -fx-cursor: hand;"/>
                        </HBox>

                        <!-- Room Info (shown after room is created) -->
                        <VBox fx:id="roomInfoSection" spacing="8" visible="false" managed="false"
                              style="-fx-background-color: #f0fdf4;
                                     -fx-background-radius: 12;
                                     -fx-border-radius: 12;
                                     -fx-border-color: rgba(18,183,106,0.2);
                                     -fx-padding: 12;
                                     -fx-margin: 10 0 0 0;">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Room:" style="-fx-text-fill: #344054; -fx-font-weight: 700; -fx-font-size: 12;"/>
                                <Label fx:id="activeRoomLabel" text="-"
                                       style="-fx-text-fill: #101828; -fx-font-weight: 900; -fx-font-size: 12;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="viewerCountLabel" text="👁 0 viewers"
                                       style="-fx-text-fill: #667085; -fx-font-size: 12;"/>
                            </HBox>
                            <HBox fx:id="accessCodeRow" spacing="8" alignment="CENTER_LEFT"
                                  visible="false" managed="false">
                                <Label text="Access Code:" style="-fx-text-fill: #344054; -fx-font-weight: 700; -fx-font-size: 12;"/>
                                <Label fx:id="accessCodeLabel" text=""
                                       style="-fx-text-fill: #1570ef; -fx-font-weight: 900; -fx-font-size: 13;"/>
                                <Button fx:id="copyAccessCodeButton" text="📋"
                                        onAction="#handleCopyAccessCode"
                                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 2 6;"/>
                            </HBox>
                            <Label fx:id="hostFpsLabel" text=""
                                   style="-fx-text-fill: #667085; -fx-font-size: 11;"/>
                        </VBox>
                    </VBox>

                    <!-- ═══ DIVIDER: Or ═══ -->
                    <HBox alignment="CENTER" spacing="12" style="-fx-padding: 4 0;">
                        <Separator HBox.hgrow="ALWAYS" opacity="0.4"/>
                        <Label text="Or" style="-fx-text-fill: #98a2b3; -fx-font-size: 12; -fx-font-weight: 600;"/>
                        <Separator HBox.hgrow="ALWAYS" opacity="0.4"/>
                    </HBox>

                    <!-- ═══ VIEWER SECTION: Session Code ═══ -->
                    <VBox fx:id="viewerSection" spacing="10">
                        <Label text="Enter the session code provided by the supporter."
                               style="-fx-text-fill: #475467; -fx-font-size: 13;"/>

                        <HBox spacing="10">
                            <TextField fx:id="joinRoomIdInput"
                                       promptText="(e.g. 123 456 789)"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-color: white;
                                              -fx-background-radius: 10;
                                              -fx-border-radius: 10;
                                              -fx-border-color: #b0b8c4;
                                              -fx-padding: 10 14;
                                              -fx-font-size: 13;"/>
                            <Button fx:id="joinRoomButton" text="Join session"
                                    onAction="#handleStartViewing"
                                    style="-fx-padding: 10 18;
                                           -fx-background-color: #1570ef;
                                           -fx-background-radius: 10;
                                           -fx-text-fill: white;
                                           -fx-font-weight: 700;
                                           -fx-cursor: hand;"/>
                        </HBox>

                        <!-- Hidden: viewer status label -->
                        <Label fx:id="viewerStatusLabel" text="" visible="false" managed="false"/>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <!-- ═══ FOOTER ═══ -->
                    <HBox alignment="CENTER_RIGHT">
                        <Label text="© 2026 ScreenAI"
                               style="-fx-text-fill: #98a2b3; -fx-font-size: 11;"/>
                    </HBox>

                    <!-- ═══ HIDDEN ELEMENTS (preserved for controller compatibility) ═══ -->
                    <VBox visible="false" managed="false">
                        <VBox fx:id="viewerConnectedPane"/>
                        <VBox fx:id="viewerStreamPane">
                            <ImageView fx:id="videoImageView" preserveRatio="true" smooth="true"/>
                            <VBox fx:id="videoPlaceholder">
                                <Label fx:id="videoDisplayLabel" text=""/>
                            </VBox>
                            <Label fx:id="roomStatusLabel" text="None"/>
                            <Label fx:id="viewerFpsLabel" text="0 FPS"/>
                            <Label fx:id="viewerDataLabel" text="0 MB"/>
                            <Label fx:id="latencyLabel" text="0 ms"/>
                            <Label fx:id="qualityLabel" text="N/A"/>
                            <Button fx:id="disconnectViewerButton" text="Disconnect" onAction="#handleStopViewing"/>
                        </VBox>
                    </VBox>

                </VBox>
            </StackPane>
        </center>

    </BorderPane>
    </ScrollPane>

    <!-- ═══════════ VIEWER FULLSCREEN SCREEN ═══════════ -->
    <VBox fx:id="viewerScreen" visible="false" managed="false"
          style="-fx-background-color: #0f172a;">

        <!-- ── Top Bar ── -->
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: #1e293b; -fx-padding: 14 28;">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="◀▶" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: 800;"/>
                <Label text="ScreenAI Viewer" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: 800;"/>
            </HBox>
            <Separator orientation="VERTICAL" prefHeight="24" opacity="0.3"/>
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="●" style="-fx-text-fill: #ef4444; -fx-font-size: 10;"/>
                <Label text="LIVE" style="-fx-text-fill: #ef4444; -fx-font-weight: 900; -fx-font-size: 12;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="viewerRoomCodeLabel" text="Room: ---"
                   style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
            <Button fx:id="viewerBackButton" text="✕ Disconnect"
                    onAction="#handleStopViewing"
                    style="-fx-padding: 8 18;
                           -fx-background-color: #dc2626;
                           -fx-background-radius: 8;
                           -fx-text-fill: white;
                           -fx-font-weight: 800;
                           -fx-font-size: 12;
                           -fx-cursor: hand;"/>
        </HBox>

        <!-- ── Video Area ── -->
        <StackPane fx:id="viewerVideoContainer" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: #000000;">
            <ImageView fx:id="viewerFullscreenVideo"
                       preserveRatio="true"
                       smooth="true"/>
            <VBox fx:id="viewerFullscreenPlaceholder" alignment="CENTER" spacing="12">
                <Label text="🎬" style="-fx-font-size: 64;"/>
                <Label text="Waiting for presenter to start streaming..."
                       style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 15; -fx-font-weight: 600;"/>
                <Label text="The stream will appear here once the presenter begins"
                       style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 12;"/>
            </VBox>
        </StackPane>

        <!-- ── Bottom Stats Bar ── -->
        <HBox alignment="CENTER" spacing="36"
              style="-fx-background-color: #1e293b; -fx-padding: 12 28;">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Room" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11;"/>
                <Label fx:id="fsRoomLabel" text="---"
                       style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 12;"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="FPS" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11;"/>
                <Label fx:id="fsFpsLabel" text="0"
                       style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 12;"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Data" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11;"/>
                <Label fx:id="fsDataLabel" text="0 MB"
                       style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 12;"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Latency" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11;"/>
                <Label fx:id="fsLatencyLabel" text="0 ms"
                       style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 12;"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Quality" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11;"/>
                <Label fx:id="fsQualityLabel" text="N/A"
                       style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 12;"/>
            </HBox>
        </HBox>

    </VBox>

</StackPane>
